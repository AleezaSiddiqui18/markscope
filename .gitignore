# =========================================================================
# MARKSCOPE — Git Ignore Rules
# =========================================================================

# --- Python Virtual Environments & Packages ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/.venv/
backend/venv/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Node.js & Frontend Artifacts ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment & Secret Files (Never commit real secrets) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
*.env

# --- Local Databases & Storage ---
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/markscope.db
markscope.db

# --- IDEs & Developer Tools ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.settings/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Logs ---
*.log
logs/
backend/logs/
